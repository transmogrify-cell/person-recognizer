{
  "name": "person-recognizer",
  "private": true,
  "version": "1.0.0",
  "description": "Browser-only person recognition trainer: BlazeFace face crops + frozen MobileNet V2 features + a small trained head, with a per-class accuracy report.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "fetch-models": "node scripts/fetch-models.mjs"
  },
  "dependencies": {
    "@mediapipe/face_detection": "~0.4.1646425229",
    "@tensorflow-models/face-detection": "^1.0.3",
    "@tensorflow-models/mobilenet": "^2.1.1",
    "@tensorflow/tfjs": "4.22.0",
    "@tensorflow/tfjs-backend-webgl": "4.22.0",
    "@tensorflow/tfjs-converter": "4.22.0",
    "@tensorflow/tfjs-core": "4.22.0",
    "@tensorflow/tfjs-layers": "4.22.0",
    "jszip": "^3.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.2.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=20.19"
  }
}
